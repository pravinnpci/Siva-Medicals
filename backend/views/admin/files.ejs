<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Uploads - Siva Medicals Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .sidebar { background: #343a40; min-height: 100vh; color: white; }
        .sidebar .nav-link { color: rgba(255,255,255,.75); padding: 12px 20px; margin: 5px 0; border-radius: 5px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: white; background: #d4a843; }
        .sidebar .nav-link i { margin-right: 10px; width: 20px; }
        .file-card { background: white; border-radius: 10px; padding: 15px; margin-bottom: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border: 1px solid #eee; transition: all 0.2s; }
        .file-card:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .file-thumb { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; }
        .bulk-bar { background: #fff3cd; border: 1px solid #ffeeba; border-radius: 8px; padding: 12px 20px; margin-bottom: 20px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 px-0 sidebar">
                <div class="p-3">
                    <h5 class="text-center mb-4 d-flex align-items-center justify-content-center gap-2">
                        <img src="/images/Logo-%20Sivamedical.png" alt="Siva Medicals Logo" style="height:28px; width:auto;">
                        Siva Medicals
                    </h5>
                    <nav class="nav flex-column gap-1">
                        <a class="nav-link d-flex align-items-center" href="/admin/dashboard">
                            <i class="fas fa-tachometer-alt me-2" style="width: 20px;"></i> <span>Dashboard</span>
                        </a>
                        <a class="nav-link d-flex align-items-center" href="/admin/contacts">
                            <i class="fas fa-envelope me-2" style="width: 20px;"></i> <span>Contact Forms</span>
                        </a>
                        <a class="nav-link active d-flex align-items-center" href="/admin/files">
                            <i class="fas fa-file-upload me-2" style="width: 20px;"></i> <span>File Uploads</span>
                        </a>
                        <a class="nav-link d-flex align-items-center" href="/admin/whatsapp">
                            <i class="fab fa-whatsapp me-2" style="width: 20px;"></i> <span>WhatsApp</span>
                        </a>
                        <a class="nav-link d-flex align-items-center" href="/admin/settings">
                            <i class="fas fa-cog me-2" style="width: 20px;"></i> <span>Site Settings</span>
                        </a>
                        <% if (user && user.role === 'super_admin') { %>
                        <a class="nav-link d-flex align-items-center" href="/admin/users">
                            <i class="fas fa-users me-2" style="width: 20px;"></i> <span>Users</span>
                        </a>
                        <% } %>
                    </nav>
                </div>
                <div class="mt-auto p-3">
                    <form method="POST" action="/admin/logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </button>
                    </form>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 px-4 py-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2><i class="fas fa-file-medical text-primary me-2"></i> Prescription & File Uploads</h2>
                    <span class="badge bg-secondary p-2"><%= files.length %> Total Files on Storage</span>
                </div>

                <!-- Bulk Selection Bar -->
                <% if (files.length > 0) { %>
                <div class="bulk-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="form-check d-flex align-items-center gap-2 mb-0">
                        <input class="form-check-input" type="checkbox" id="selectAllFiles" style="transform: scale(1.2); cursor: pointer;">
                        <label class="form-check-label fw-bold text-dark" for="selectAllFiles" style="cursor: pointer;">
                            Select All (<span id="selectedFilesCount">0</span> selected)
                        </label>
                    </div>
                    <div>
                        <button id="bulkDeleteFilesBtn" class="btn btn-danger btn-sm fw-bold shadow-sm" disabled onclick="executeBulkDeleteFiles()">
                            <i class="fas fa-trash-alt me-1"></i> Bulk Delete Selected Files
                        </button>
                    </div>
                </div>
                <% } %>

                <!-- Files List -->
                <div id="filesList">
                    <% if (files.length === 0) { %>
                        <div class="text-center py-5 bg-white rounded shadow-sm">
                            <i class="fas fa-folder-open fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No files uploaded yet</h4>
                            <p class="text-muted">Uploaded customer prescriptions will automatically appear here.</p>
                        </div>
                    <% } else { %>
                        <% files.forEach(file => { %>
                            <div class="file-card d-flex justify-content-between align-items-center flex-wrap gap-2" id="file-row-<%= file.filename %>">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="checkbox" class="form-check-input file-checkbox" data-filename="<%= file.filename %>" style="transform: scale(1.2); cursor: pointer;" onclick="updateSelectedFilesCounter();">
                                    <% if (file.filename.match(/\.(jpg|jpeg|png|gif|webp)$/i)) { %>
                                        <img src="/uploads/<%= file.filename %>" class="file-thumb border" alt="Preview">
                                    <% } else if (file.filename.match(/\.pdf$/i)) { %>
                                        <div class="file-thumb bg-danger text-white d-flex align-items-center justify-content-center">
                                            <i class="fas fa-file-pdf fa-lg"></i>
                                        </div>
                                    <% } else { %>
                                        <div class="file-thumb bg-secondary text-white d-flex align-items-center justify-content-center">
                                            <i class="fas fa-file-alt fa-lg"></i>
                                        </div>
                                    <% } %>
                                    <div>
                                        <h6 class="mb-1 text-dark fw-bold"><%= file.original_name || file.filename %></h6>
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i> <%= file.uploaded_at ? new Date(file.uploaded_at).toLocaleString() : 'Recent' %>
                                            <span class="ms-2 badge bg-light text-dark border">
                                                <%= (file.size / 1024).toFixed(1) %> KB
                                            </span>
                                            <% if (file.filename.startsWith('prescription')) { %>
                                                <span class="badge bg-success ms-1">Prescription</span>
                                            <% } %>
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="/uploads/<%= file.filename %>" target="_blank" class="btn btn-sm btn-outline-primary" title="View Full File">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>
                                    <a href="/uploads/<%= file.filename %>" download="<%= file.filename %>" class="btn btn-sm btn-outline-success" title="Download">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteFileByName('<%= file.filename %>')" title="Delete from Storage">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const selectAllFilesCheckbox = document.getElementById('selectAllFiles');
        const bulkDeleteFilesBtn = document.getElementById('bulkDeleteFilesBtn');
        const selectedFilesCountSpan = document.getElementById('selectedFilesCount');

        if (selectAllFilesCheckbox) {
            selectAllFilesCheckbox.addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('.file-checkbox');
                checkboxes.forEach(cb => { cb.checked = selectAllFilesCheckbox.checked; });
                updateSelectedFilesCounter();
            });
        }

        function updateSelectedFilesCounter() {
            const checked = document.querySelectorAll('.file-checkbox:checked');
            const count = checked.length;
            if (selectedFilesCountSpan) selectedFilesCountSpan.textContent = count;
            if (bulkDeleteFilesBtn) bulkDeleteFilesBtn.disabled = (count === 0);
        }

        async function executeBulkDeleteFiles() {
            const checked = document.querySelectorAll('.file-checkbox:checked');
            const filenames = Array.from(checked).map(cb => cb.dataset.filename);
            if (filenames.length === 0) return;

            if (!confirm(`Are you sure you want to permanently delete all ${filenames.length} selected file(s) from server storage and database?`)) {
                return;
            }

            try {
                const response = await fetch('/admin/files/bulk-delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ filenames: filenames })
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    filenames.forEach(fn => {
                        const el = document.getElementById('file-row-' + fn);
                        if (el) el.remove();
                    });
                    if (selectAllFilesCheckbox) selectAllFilesCheckbox.checked = false;
                    updateSelectedFilesCounter();
                    alert(result.message || 'Selected files deleted successfully');
                    window.location.reload();
                } else {
                    alert('Failed to delete: ' + (result.error || 'Server error'));
                }
            } catch (err) {
                console.error('Bulk delete error:', err);
                alert('Error performing bulk delete');
            }
        }

        async function deleteFileByName(filename) {
            if (!confirm(`Are you sure you want to permanently delete "${filename}" from server storage and database?`)) {
                return;
            }

            try {
                const response = await fetch(`/admin/files/delete-by-name`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ filename: filename })
                });

                const res = await response.json();
                if (response.ok && res.success) {
                    const el = document.getElementById('file-row-' + filename);
                    if (el) el.remove();
                    updateSelectedFilesCounter();
                    alert('File deleted successfully from server storage and database.');
                } else {
                    alert('Failed to delete file: ' + (res.error || 'Unknown error'));
                }
            } catch (err) {
                console.error('Delete error:', err);
                alert('Error deleting file');
            }
        }
    </script>
</body>
</html>