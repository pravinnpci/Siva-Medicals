# ========================================
# SIVA MEDICALS - ENVIRONMENT EXAMPLE
# ========================================

# Supabase PostgreSQL Database (IPv4 Pooler / Direct)
SIVA_DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
SIVA_SUPABASE_URL=https://your-project-ref.supabase.co
SIVA_SUPABASE_ANON_KEY=your-supabase-anon-key

# Session Security
SIVA_SESSION_SECRET=your-random-32-character-session-secret

# EmailJS Configuration
SIVA_EMAILJS_SERVICE_ID=sivamedical
SIVA_EMAILJS_TEMPLATE_ID=template_2fzsb0d
SIVA_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Company Contact & Email Configuration
SIVA_COMPANY_EMAIL=your-company-email@gmail.com

# Twilio WhatsApp Configuration
SIVA_TWILIO_ACCOUNT_SID=your_twilio_account_sid
SIVA_TWILIO_AUTH_TOKEN=your_twilio_auth_token
SIVA_TWILIO_WHATSAPP_NUMBER=+14155238886
SIVA_WEBSITE_WHATSAPP_NUMBER=9952930484

# Server Configuration
SIVA_PORT=3001
SIVA_NODE_ENV=production

# Vercel Configuration
SIVA_VERCEL_TOKEN=your_vercel_api_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id